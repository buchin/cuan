# ==============================================================================
# Cuan Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before starting the application.
# NOTE: Never commit sensitive credentials or secret keys to version control!
# ==============================================================================

# Application Environment (production / development)
CUAN_ENV=production
CUAN_APP_VERSION=0.1.0
CUAN_IMAGE=cuan:0.1.0

# Server Port
PORT=8080

# PostgreSQL Database Credentials
POSTGRES_DB=cuan
POSTGRES_USER=cuan
POSTGRES_PASSWORD=replace_with_strong_password_min_16_chars

# Database Connection URL
# For Docker Compose, host is 'db'
DATABASE_URL=postgres://cuan:replace_with_strong_password_min_16_chars@db:5432/cuan?sslmode=disable

# Database Connection Pool Settings
CUAN_DB_MAX_OPEN_CONNS=25
CUAN_DB_MAX_IDLE_CONNS=10
CUAN_DB_CONN_MAX_LIFETIME=5m
CUAN_DB_CONN_MAX_IDLE_TIME=1m

# Automatic Schema Migrations on Boot (true / false)
CUAN_AUTO_MIGRATE=true

# Static Web Dist Directory
CUAN_STATIC_DIR=/app/web/dist

# Single-Owner Authentication Secret (Generate a random 32+ character key)
CUAN_AUTH_SECRET=replace_with_random_32_character_auth_secret_key

# Reverse Proxy & HTTPS Domain Configuration
# In production, Caddy reverse proxy serves cuan.work as the canonical primary domain
# alongside cuan.dojo.cc (co-primary/legacy), and permanently redirects (301)
# cuan.chat to cuan.work preserving all paths and query parameters.
# For custom deployment, staging, or local development, set CUAN_DOMAIN (defaults to localhost).
CUAN_DOMAIN=localhost
ACME_EMAIL=admin@example.com

# Task Runner Configuration
CUAN_RUNNER_ID=runner-01
CUAN_RUNNER_INTERVAL_SEC=5

# Optional GitHub OAuth App (administrator setup once; users authorize on GitHub).
# Register the exact callback URL below in the GitHub OAuth App settings.
CUAN_GITHUB_CLIENT_ID=
CUAN_GITHUB_CLIENT_SECRET=
CUAN_GITHUB_REDIRECT_URL=https://your-cuan.example/api/v1/integrations/github/oauth/callback
